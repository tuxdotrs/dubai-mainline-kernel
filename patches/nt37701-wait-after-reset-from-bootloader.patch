--- a/drivers/gpu/drm/panel/panel-novatek-nt37701.c
+++ b/drivers/gpu/drm/panel/panel-novatek-nt37701.c
@@ -46,6 +46,7 @@
 	struct regulator *supply;
 	struct gpio_desc *reset_gpio;
 	const struct nt37701_panel_desc *desc;
+	bool reset_while_on;
 };
 
 static inline
@@ -385,6 +386,15 @@
 
 	nt37701_panel_reset(ctx);
 
+	/*
+	 * Reset in sleep-out mode makes the panel run its own power-off
+	 * sequence, and it ignores commands until that is done.
+	 */
+	if (ctx->reset_while_on) {
+		msleep(120);
+		ctx->reset_while_on = false;
+	}
+
 	ret = nt37701_panel_on(ctx, mode);
 	if (ret < 0) {
 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
@@ -594,6 +604,9 @@
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
 				     "Failed to get reset-gpios\n");
 
+	/* The bootloader may have left the panel on; we just reset it */
+	ctx->reset_while_on = true;
+
 	ctx->dsi = dsi;
 	ctx->desc = of_device_get_match_data(&dsi->dev);
 	mipi_dsi_set_drvdata(dsi, ctx);
