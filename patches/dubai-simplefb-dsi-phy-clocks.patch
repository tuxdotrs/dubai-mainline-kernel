--- a/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi
@@ -96,8 +96,18 @@
 			stride = <(1080 * 4)>;
 			format = "a8r8g8b8";
 
+			/*
+			 * The DSI PHY PLL outputs are the parents of byte0 and
+			 * pclk0. Listing them makes simpledrm wait for the PHY:
+			 * enabled while their parent was still unregistered,
+			 * byte0/pclk0's enable counts never reached the PHY
+			 * clocks, and releasing them at the msm handoff hit
+			 * "dsi0_phy_pll_out_byteclk already disabled".
+			 */
 			clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
 				 <&dispcc DISP_CC_MDSS_MDP_CLK>,
+				 <&mdss_dsi_phy DSI_BYTE_PLL_CLK>,
+				 <&mdss_dsi_phy DSI_PIXEL_PLL_CLK>,
 				 <&dispcc DISP_CC_MDSS_BYTE0_CLK>,
 				 <&dispcc DISP_CC_MDSS_BYTE0_INTF_CLK>,
 				 <&dispcc DISP_CC_MDSS_PCLK0_CLK>,
